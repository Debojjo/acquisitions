# Development (local)
APP_PORT=3000
# For dev, docker-compose.dev.yml uses `npm run dev` by default. Override if needed.
# Examples:
# APP_COMMAND=npm run dev
# APP_COMMAND=node --watch src/index.js
APP_COMMAND=

# Neon Local settings (required to create/connect Neon branches)
# Replace placeholders via your shell before running compose. Do NOT commit real values.
NEON_API_KEY=napi_aga3x0aldngby4xzff5v4cr7u0ezed9r477hfw0rcyl4p1nq0sp00q1wkk5ejh9m
NEON_PROJECT_ID=nameless-union-41787484
# Optional: create ephemeral branches from this parent branch (e.g., main branch ID)
PARENT_BRANCH_ID=br-divine-pine-a1ha8k7b
# Optional: set to false to persist branches after container shutdown
DELETE_BRANCH=true

# The logical database name that Neon Local will expose
DATABASE_NAME=acquisitions

ARCJET_KEY=ajkey_01k9knq1jdfvarqhpw7rkfbrtf

# DATABASE_URL will be computed by docker-compose.dev.yml as:
# postgres://neon:npg@neon-local:5432/${DATABASE_NAME}
# You can also set it explicitly if your app reads it directly:
# DATABASE_URL=postgres://neon:npg@neon-local:5432/acquisitions
